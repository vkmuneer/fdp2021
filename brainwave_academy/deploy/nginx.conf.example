# Nginx reverse proxy: forwards public traffic on port 80/443 to the app
# running locally on port 8000 (started by gunicorn via brainwave.service).
# Copy to /etc/nginx/sites-available/brainwave, edit server_name, then:
#
#   sudo ln -s /etc/nginx/sites-available/brainwave /etc/nginx/sites-enabled/
#   sudo nginx -t
#   sudo systemctl reload nginx
#
# Then get free HTTPS with:
#   sudo certbot --nginx -d yourdomain.com

server {
    listen 80;
    server_name yourdomain.com;  # or your server's IP if you don't have a domain yet

    client_max_body_size 10M;  # allow the Excel bulk-upload file to come through

    location /static/ {
        alias /home/brainwave/fdp2021/brainwave_academy/app/static/;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
